# Public analytics is disabled when empty.
NEXT_PUBLIC_ANALYTICS_ID=

# Future scheduling provider. The local pending-request provider is used when empty.
BOOKING_PROVIDER_ENDPOINT=
BOOKING_PROVIDER_API_KEY=

# Future notification provider. No email or SMS is sent when empty.
NOTIFICATION_PROVIDER_ENDPOINT=
NOTIFICATION_PROVIDER_API_KEY=

# Reserved integration point only. Payments are intentionally not implemented.
PAYMENT_PROVIDER=
